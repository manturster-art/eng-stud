# Required in production. Set in Railway → Variables tab.

# Random long string (e.g. `openssl rand -hex 48`). Used to sign JWT session tokens.
# 기본값은 코드에 박혀 있지만 운영에서는 반드시 교체할 것.
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth 2.0 Client ID. 본인 Google Cloud Console 프로젝트에서 발급.
# 코드에 박힌 기본값은 데모용이며, 운영 배포 URL을 Authorized JavaScript origins에
# 추가하려면 본인 Client ID가 필요함.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SQLite 파일 경로. Railway 영구 볼륨을 /data 에 마운트한 경우 /data/data.db 권장.
# 미설정 시 컨테이너 작업 디렉토리의 ./data.db 에 저장됨 (재배포 시 초기화).
DATABASE_PATH=/data/data.db

# Express 포트 — Railway가 자동 주입함. 로컬 실행 시 미설정이면 5000 사용.
# PORT=5000
